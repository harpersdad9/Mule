# Supabase — get from your Supabase project dashboard
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Stripe — get from Stripe Dashboard
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Strava — get from strava.com/settings/api
EXPO_PUBLIC_STRAVA_CLIENT_ID=your-strava-client-id

# Google — get from console.cloud.google.com (OAuth 2.0 Client ID, Web Application type)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# --- SERVER-ONLY: set via Supabase Edge Function secrets, never put in .env ---
# supabase secrets set STRIPE_SECRET_KEY=sk_test_...
# supabase secrets set STRIPE_WEBHOOK_SECRET=whsec_...
# supabase secrets set STRAVA_CLIENT_SECRET=your-strava-client-secret
# supabase secrets set SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# supabase secrets set GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# supabase secrets set GOOGLE_CLIENT_SECRET=your-google-client-secret
